# Local default works without Docker. Switch to Postgres when compose is up:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workcore
DATABASE_URL=sqlite+aiosqlite:///./workcore.db

# Provider selection: auto prefers Groq, then Anthropic, then local policy.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
API_KEY=test-key-12345
MAX_AGENT_ITERATIONS=6
CONTEXT_TOKEN_BUDGET=4000
CLAIM_STALE_SECONDS=30
MAX_JOB_RETRIES=3
JOB_RETRY_BASE_SECONDS=2
JOB_HEARTBEAT_SECONDS=5
EMBEDDING_DIMENSIONS=64
RETRIEVAL_CHUNK_CHARS=800
RETRIEVAL_CHUNK_OVERLAP_CHARS=120
LOG_LEVEL=INFO
